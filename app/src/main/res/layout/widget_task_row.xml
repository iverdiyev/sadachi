<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/widget_row_background">
    <TextView android:id="@+id/widget_check" android:layout_width="48dp" android:layout_height="48dp" android:text="○" android:textSize="30sp" android:gravity="center" android:textColor="#4970DF"/>
    <LinearLayout android:id="@+id/widget_task_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingEnd="10dp">
        <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="#212339" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_task_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#696E85" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
