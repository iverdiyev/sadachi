<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_check" android:layout_width="28dp" android:layout_height="32dp" android:text="○" android:textSize="18dp" android:gravity="center" android:textColor="#4970DF"/>
    <LinearLayout android:id="@+id/widget_task_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#212339" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_task_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#696E85" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
